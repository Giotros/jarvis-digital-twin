# Jarvis George — Ollama model definition
#
# Χρήση (αφού βάλεις το .gguf σε αυτόν τον φάκελο):
#   ./scripts/setup_local_model.sh
#
# Ή χειροκίνητα:
#   docker cp ~/jarvis/models jarvis-ollama:/models
#   docker exec jarvis-ollama ollama create jarvis -f /models/Modelfile

FROM ./krikri-jarvis-Q4_K_M.gguf

# Llama-3 / Krikri chat template. Πρέπει να ταιριάζει byte-για-byte με το
# format του training (βλ. format_pair στο notebook) — αλλιώς το μοντέλο
# βλέπει διαφορετική δομή στο inference απ' ό,τι έμαθε.
TEMPLATE """{{ if .System }}<|start_header_id|>system<|end_header_id|>

{{ .System }}<|eot_id|>{{ end }}{{ if .Prompt }}<|start_header_id|>user<|end_header_id|>

{{ .Prompt }}<|eot_id|>{{ end }}<|start_header_id|>assistant<|end_header_id|>

{{ .Response }}<|eot_id|>"""

SYSTEM """Είσαι ο Γιώργος Τροχίδης, φοιτητής στο Πανεπιστήμιο Πελοποννήσου στην Τρίπολη.
Μιλάς ΠΑΝΤΑ σε πρώτο ενικό πρόσωπο — εσύ ΕΙΣΑΙ ο Γιώργος, ΟΧΙ AI ή βοηθός.
ΥΦΟΣ: Φιλικό, casual, σαν να μιλάς σε φίλο.
ΜΗΚΟΣ: 1-3 προτάσεις. Μην είσαι μονολεκτικός.
ΚΑΝΟΝΕΣ: Μην επινοείς πληροφορίες. Αν δεν ξέρεις, πες 'δεν θυμάμαι' ή 'δεν ξέρω'."""

# Sampling — ίδιες τιμές με το orchestration API ώστε τα αποτελέσματα
# της αξιολόγησης να είναι συγκρίσιμα μεταξύ Colab και τοπικού.
PARAMETER temperature 0.6
PARAMETER top_p 0.9
PARAMETER top_k 40
PARAMETER repeat_penalty 1.15
PARAMETER num_ctx 4096
PARAMETER num_predict 150

# Stop tokens: χωρίς αυτά το μοντέλο συνεχίζει και παράγει τον επόμενο
# γύρο διαλόγου μόνο του — το κλασικό "απαντάει και στον εαυτό του".
PARAMETER stop "<|eot_id|>"
PARAMETER stop "<|start_header_id|>"
PARAMETER stop "<|end_header_id|>"
