    {
      "parameters": {
        "jsCode": "// Format weather data as context for LLM\nconst w = $input.first().json;\nconst message = $('Webhook: Receive Message').item.json.body.message;\n\nlet context = 'ΚΑΙΡΟΣ:\\n';\nif (w.main) {\n  const city = w.name || 'Άγνωστη πόλη';\n  const temp = Math.round(w.main.temp);\n  const feelsLike = Math.round(w.main.feels_like);\n  const desc = w.weather?.[0]?.description || '';\n  const humidity = w.main.humidity;\n  const wind = w.wind?.speed || 0;\n  \n  context += `Πόλη: ${city}\\n`;\n  context += `Θερμοκρασία: ${temp}°C (αισθητή: ${feelsLike}°C)\\n`;\n  context += `Καιρός: ${desc}\\n`;\n  context += `Υγρασία: ${humidity}%\\n`;\n  context += `Άνεμος: ${wind} m/s\\n`;\n} else {\n  context += 'Δεν βρέθηκαν δεδομένα καιρού.\\n';\n}\n\nreturn [{ json: { context, original_message: message } }];"
      },
