        "jsCode": "// Format GitHub activity as context for LLM\nconst events = $input.first().json;\nconst message = $('Webhook: Receive Message').item.json.body.message;\n\nlet context = 'GITHUB ACTIVITY:\\n';\nconst eventList = Array.isArray(events) ? events : [];\n\nif (eventList.length > 0) {\n  for (const event of eventList.slice(0, 10)) {\n    const type = event.type || '';\n    const repo = event.repo?.name || '';\n    const date = event.created_at ? new Date(event.created_at).toLocaleDateString('el-GR') : '';\n    \n    let detail = '';\n    if (type === 'PushEvent') {\n      const commits = event.payload?.commits?.length || 0;\n      detail = `Push: ${commits} commit(s)`;\n    } else if (type === 'PullRequestEvent') {\n      detail = `PR: ${event.payload?.action || ''} — ${event.payload?.pull_request?.title || ''}`;\n    } else if (type === 'IssuesEvent') {\n      detail = `Issue: ${event.payload?.action || ''} — ${event.payload?.issue?.title || ''}`;\n    } else if (type === 'CreateEvent') {\n      detail = `Created ${event.payload?.ref_type || ''} ${event.payload?.ref || ''}`;\n    } else {\n      detail = type.replace('Event', '');\n    }\n    \n    context += `- ${date} [${repo}] ${detail}\\n`;\n  }\n} else {\n  context += 'Δεν βρέθηκε πρόσφατη δραστηριότητα.\\n';\n}\n\nreturn [{ json: { context, num_events: eventList.length, original_message: message } }];"
      },
      "id": "format-github-context",
      "name": "Format GitHub Context",
      "type": "n8n-nodes-base.code",
