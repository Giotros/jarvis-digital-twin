      "id": "calendar-lookup",
      "name": "Calendar: Get Events",
      "type": "n8n-nodes-base.googleCalendar",
      "typeVersion": 1,
      "disabled": true,
      "position": [1380, 700],
      "credentials": {
        "googleCalendarOAuth2Api": {
