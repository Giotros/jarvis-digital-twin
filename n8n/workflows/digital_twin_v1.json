    {
      "parameters": {
        "jsCode": "// Extract relevant info from Gmail results and format as context\nconst emails = $input.all();\nconst message = $('Webhook: Receive Message').item.json.body.message;\n\nlet context = 'ΠΡΟΣΦΑΤΑ EMAILS:\\n';\nfor (const email of emails.slice(0, 5)) {\n  const subject = email.json.subject || 'Χωρίς θέμα';\n  const from = email.json.from?.emailAddress || 'Άγνωστος';\n  const date = email.json.date || '';\n  const snippet = email.json.snippet || '';\n  context += `- ${date}: ${subject} (από ${from}) — ${snippet}\\n`;\n}\n\nreturn [{\n  json: {\n    context: context,\n    num_results: emails.length,\n    original_message: message\n  }\n}];"
      },
      "id": "format-email-context",
      "name": "Format Email Context",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1620, 560]
    },
