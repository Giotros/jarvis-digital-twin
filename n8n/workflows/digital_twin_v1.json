    {
      "parameters": {
        "jsCode": "// Length check: if response > 3 sentences, truncate\nconst text = $input.first().json.processed;\nconst sentences = text.split(/[.!;]+/).filter(s => s.trim().length > 0);\n\nlet final_reply = text;\nif (sentences.length > 3) {\n  final_reply = sentences.slice(0, 3).join('. ').trim();\n  if (!final_reply.endsWith('.') && !final_reply.endsWith('!')) {\n    final_reply += '.';\n  }\n}\n\nreturn [{\n  json: {\n    reply: final_reply,\n    original_length: sentences.length,\n    truncated: sentences.length > 3,\n    guardrails_applied: $input.first().json.changed,\n    intent: $('Classify Intent').item.json.intent,\n    confidence: $('Classify Intent').item.json.confidence\n  }\n}];"
      },
      "id": "length-check",
