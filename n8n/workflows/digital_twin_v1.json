        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Parse calendar events and find free slots\nconst events = $input.all();\nconst message = $('Webhook: Receive Message').item.json.body.message;\n\nlet context = 'ΠΡΟΓΡΑΜΜΑ ΕΒΔΟΜΑΔΑΣ:\\n';\nconst busySlots = [];\n\nfor (const event of events) {\n  const title = event.json.summary || 'Χωρίς τίτλο';\n  const start = event.json.start?.dateTime || event.json.start?.date || '';\n  const end = event.json.end?.dateTime || event.json.end?.date || '';\n  const location = event.json.location || '';\n  \n  const startDate = new Date(start);\n  const dayName = ['Κυριακή','Δευτέρα','Τρίτη','Τετάρτη','Πέμπτη','Παρασκευή','Σάββατο'][startDate.getDay()];\n  const timeStr = startDate.toLocaleTimeString('el-GR', {hour: '2-digit', minute: '2-digit'});\n  \n  context += `- ${dayName} ${timeStr}: ${title}`;\n  if (location) context += ` (${location})`;\n  context += '\\n';\n  \n  busySlots.push({start, end, title});\n}\n\n// Simple free slot detection for tomorrow\nif (events.length === 0) {\n  context += '\\nΔΙΑΘΕΣΙΜΟΤΗΤΑ: Δεν υπάρχουν ραντεβού, είμαι διαθέσιμος.';\n} else {\n  context += `\\nΣΥΝΟΛΟ: ${events.length} ραντεβού αυτή τη βδομάδα.`;\n}\n\nreturn [{\n  json: {\n    context: context,\n    num_events: events.length,\n    original_message: message\n  }\n}];"
      },
      "id": "format-calendar-context",
      "name": "Format Calendar Context",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1620, 700]
