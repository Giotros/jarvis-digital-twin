        "jsCode": "// Format news headlines as context for LLM\nconst data = $input.first().json;\nconst message = $('Webhook: Receive Message').item.json.body.message;\n\nlet context = 'ΕΙΔΗΣΕΙΣ ΕΛΛΑΔΑΣ:\\n';\nif (data.articles && data.articles.length > 0) {\n  for (const article of data.articles.slice(0, 5)) {\n    const title = article.title || '';\n    const source = article.source?.name || '';\n    const desc = article.description || '';\n    context += `- [${source}] ${title}: ${desc.substring(0, 100)}\\n`;\n  }\n} else {\n  context += 'Δεν βρέθηκαν νέα.\\n';\n}\n\nreturn [{ json: { context, num_articles: data.articles?.length || 0, original_message: message } }];"
