# Jarvis George — Environment Variables
# Copy to .env and customize

# n8n credentials
N8N_USER=jarvis
N8N_PASSWORD=jarvis2026

# Twin state
JARVIS_ENABLED=true

# Ollama
JARVIS_OLLAMA_URL=http://ollama:11434
JARVIS_MODEL=krikri-8b

# ChromaDB
JARVIS_CHROMA_URL=http://chromadb:8000

# RAG corpus (sanitized training data)
JARVIS_CORPUS=/app/data/jarvis_training_data_sanitized.json
