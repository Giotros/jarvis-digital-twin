# ============================================================
# CRITICAL: PII / personal data must NEVER be committed.
# GDPR: raw Viber/email exports contain third-party personal
# data (names, phones, AFM, AMKA, IBAN). Keep them out of git.
# ============================================================
data/
*.db
*.mbox
jarvis_training_data*.json
persona_chat_training_data*.json
config/contacts.txt

# Models / adapters (large binaries live on Drive, not git)
models/*
!models/Modelfile
*.safetensors
*.gguf
checkpoints/

# Secrets
.env
*.pem
credentials*.json
token*.json

# Python
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
*.egg-info/
build/
dist/
.venv/
venv/

# Notebooks: keep outputs out of git noise (optional)
.ipynb_checkpoints/

# OS
.DS_Store
Thumbs.db

# Node / frontend build
node_modules/
frontend/dist/
*.timestamp-*.mjs

# n8n working copy (re-exported on demand)
current_workflow.json

# ── Personal data of the data subject ────────────────────────
# The repository is public so the work can be shown; these files
# are not. Templates with the same structure are committed as
# *.example.yaml so the code and README still make sense.
config/identity.yaml
config/golden_examples.yaml

# University paperwork — the application form carries a student
# registration number and a signature.
*.pdf
.commit-message.txt
config/surnames.txt
docker-compose.yml.bak

# Κείμενο διπλωματικής — δική του πνευματική εργασία, όχι κώδικας.
# Το repo είναι δημόσιο για να φαίνεται η υλοποίηση, όχι το κείμενο που
# βαθμολογείται. Τα αποτελέσματα μετρήσεων μένουν ορατά ως τεκμηρίωση
# του κώδικα· τα κεφάλαια και η βιβλιογραφία όχι.
docs/bibliography.md
docs/chapter_*.md
docs/thesis_skeleton.md
